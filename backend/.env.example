ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=5000
PORT=5000
DEBUG=False

# Required in production: use a long random value.
SECRET_KEY=replace-with-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_VERSION=1.0.0

MODEL_PATH=models/parkinson_model.pkl
FEATURE_NAMES_PATH=models/feature_names.txt
# Production (recommended on Render): PostgreSQL URL from Render dashboard.
# Example:
# DATABASE_URL=postgresql://user:password@hostname:5432/database
# Local SQLite fallback (development only):
# DATABASE_URL=sqlite:///database/mediguardian.db
DATABASE_URL=
DATABASE_PATH=database/mediguardian.db
DATABASE_SSL_MODE=require
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_MAX_RETRIES=8
DB_CONNECT_RETRY_DELAY_SECONDS=1.5
# Keep False in production unless you intentionally deploy SQLite with persistent disk.
ALLOW_SQLITE_IN_PRODUCTION=False
TEMP_DIR=temp
UPLOAD_SUBDIR=uploads

MAX_AUDIO_DURATION=30
MIN_AUDIO_DURATION=3
SUPPORTED_FORMATS=["wav","mp3","ogg","flac","m4a"]
MAX_FILE_SIZE_MB=50

# Include your deployed frontend origin here in production, for example:
# CORS_ORIGINS=["https://neuroscreen-frontend.onrender.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]
# Set empty string to disable regex in strict production deployments.
CORS_ALLOW_ORIGIN_REGEX=http://(localhost|127\\.0\\.0\\.1):\\d+
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type"]
